# Copie para .env.production no SERVIDOR e preencha. Não versionar o arquivo real.

# Domínio apontado (DNS tipo A) para o IP do servidor — usado pelo Caddy para emitir o certificado HTTPS
DOMAIN=seudominio.com.br

# Endereço público do site (sitemap, link canônico e Open Graph)
SITE_URL=https://seudominio.com.br

# Opcional: imagem pronta de um registry (ex.: GitHub Container Registry) em vez de buildar no servidor
# IMAGE=ghcr.io/jeisiqueira/portfolio:latest
