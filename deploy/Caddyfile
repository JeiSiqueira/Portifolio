# Caddy: proxy reverso com HTTPS automático.
# A variável DOMAIN vem do .env.production (ex.: jeimili.dev).

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000

	log {
		output stdout
		format console
	}
}

# Redireciona www -> domínio principal
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
