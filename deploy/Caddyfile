# Caddy: proxy reverso com HTTPS automático.
# A variável DOMAIN vem do .env.production (ex.: jeimili.dev).

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000

	log {
		output stdout
		format console
	}
}

# Redireciona www -> domínio principal
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Sistema de Agendamento (outro projeto Docker, em ~/agendamento).
# Os containers entram na rede externa "edge" com estes aliases.
api-agendamento.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy agendamento-api:8080
}

agendamento.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy agendamento-web:8080
}
